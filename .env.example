# Google AI Studio / Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Cloud Cluster Configuration
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Pydantic Logfire Observability
LOGFIRE_TOKEN=your_logfire_write_token_here
LOGFIRE_SEND_TO_LOGFIRE=if-token-present

# Model Configuration
PRIMARY_EMBEDDING_MODEL=gemini-embedding-2
FALLBACK_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072

PRIMARY_LLM_MODEL=gemini-3.5-flash-lite
FALLBACK_LLM_MODEL=gemini-3.1-flash-lite

# Fixed Chunking Baseline Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
